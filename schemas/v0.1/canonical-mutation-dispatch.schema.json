{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/canonical-mutation-dispatch.schema.json",
  "title": "Saudi Defense Atlas Canonical Mutation Dispatch",
  "description": "Immutable operational envelope binding one exact human-approved editorial decision to the single-writer canonical mutation lane. The envelope carries no approval, mutation, or publication authority by itself.",
  "type": "object",
  "required": [
    "id",
    "review_packet_id",
    "review_packet_sha256",
    "proposal_id",
    "proposal_sha256",
    "review_decision_id",
    "review_decision_sha256",
    "editorial_decision_binding_id",
    "editorial_decision_binding_sha256",
    "target_records",
    "serialization_key",
    "enqueued_at",
    "authority"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "review_packet_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "review_packet_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "proposal_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "proposal_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "review_decision_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "review_decision_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "editorial_decision_binding_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "editorial_decision_binding_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "target_records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["resource_type", "record_id"],
        "properties": {
          "resource_type": {
            "type": "string",
            "enum": ["entity", "claim", "event", "source", "document", "evidence"]
          },
          "record_id": { "$ref": "common.schema.json#/$defs/canonical_id" }
        },
        "additionalProperties": false
      }
    },
    "serialization_key": { "const": "canonical-global-single-writer" },
    "enqueued_at": { "type": "string", "format": "date-time" },
    "authority": {
      "type": "object",
      "required": [
        "mode",
        "approval_authority",
        "canonical_mutation_authority",
        "publication_authority"
      ],
      "properties": {
        "mode": { "const": "dispatch_only" },
        "approval_authority": { "const": false },
        "canonical_mutation_authority": { "const": false },
        "publication_authority": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
