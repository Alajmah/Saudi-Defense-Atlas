{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/document.schema.json",
  "title": "Saudi Defense Atlas Document",
  "type": "object",
  "required": ["id", "source_id", "retrieved_at", "content_sha256", "language"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "source_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "title": { "$ref": "common.schema.json#/$defs/localized_text" },
    "canonical_url": { "type": ["string", "null"], "format": "uri" },
    "retrieved_url": { "type": ["string", "null"], "format": "uri" },
    "archival_url": { "type": ["string", "null"], "format": "uri" },
    "published_at": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/temporal_value" },
        { "type": "null" }
      ]
    },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "language": {
      "type": "string",
      "enum": ["ar", "en", "multilingual", "other", "unknown"]
    },
    "document_type": {
      "type": "string",
      "enum": [
        "press_release",
        "procurement_notice",
        "contract_notice",
        "official_statement",
        "report",
        "article",
        "product_documentation",
        "filing",
        "web_page",
        "pdf",
        "social_post",
        "other"
      ]
    },
    "media_type": { "type": ["string", "null"] },
    "content_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "content_length_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "version_of": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/canonical_id" },
        { "type": "null" }
      ]
    },
    "publisher_document_id": { "type": ["string", "null"] },
    "access_notes": { "type": ["string", "null"] },
    "licensing_notes": { "type": ["string", "null"] }
  },
  "anyOf": [
    {
      "required": ["canonical_url"],
      "properties": {"canonical_url": {"type": "string", "format": "uri"}}
    },
    {
      "required": ["retrieved_url"],
      "properties": {"retrieved_url": {"type": "string", "format": "uri"}}
    },
    {
      "required": ["publisher_document_id"],
      "properties": {"publisher_document_id": {"type": "string", "minLength": 1}}
    }
  ],
  "additionalProperties": false
}