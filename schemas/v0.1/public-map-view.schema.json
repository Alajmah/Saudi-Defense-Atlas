{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/public-map-view.schema.json",
  "title": "Saudi Defense Atlas Public Non-Operational Map View",
  "description": "Backend-neutral map projection for fixed, publicly documented facilities only. It excludes live deployment, movement, readiness, patrol, stock, and precise operational-location semantics.",
  "type": "object",
  "required": ["scope", "projected_at", "features", "provenance"],
  "properties": {
    "scope": { "const": "public_non_operational_fixed_facilities" },
    "projected_at": { "type": "string", "format": "date-time" },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/map_feature" }
    },
    "provenance": {
      "type": "object",
      "required": ["record_ids", "revision_ids"],
      "properties": {
        "record_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "revision_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "evidence_id", "evidence_role", "document_id", "source_id",
        "source_class", "publisher", "locator", "retrieved_at"
      ],
      "properties": {
        "evidence_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
        "evidence_role": { "type": "string", "enum": ["supports", "contradicts", "contextualizes"] },
        "document_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
        "source_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
        "source_class": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
        "publisher": { "$ref": "common.schema.json#/$defs/localized_text" },
        "document_title": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/localized_text" },
            { "type": "null" }
          ]
        },
        "url": { "type": ["string", "null"], "format": "uri" },
        "published_at": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/temporal_value" },
            { "type": "null" }
          ]
        },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "locator": { "$ref": "evidence.schema.json#/properties/locator" }
      },
      "additionalProperties": false
    },
    "map_feature": {
      "type": "object",
      "required": [
        "id", "entity_id", "entity_type", "category", "names",
        "coordinate", "coordinate_claim_ids", "citations"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
        "entity_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
        "entity_type": { "const": "facility" },
        "category": {
          "type": "string",
          "enum": [
            "air_base", "naval_base", "military_city", "training_center",
            "military_education", "defense_industry_facility", "administrative_facility"
          ]
        },
        "names": { "$ref": "common.schema.json#/$defs/localized_text" },
        "location_label": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/localized_text" },
            { "type": "null" }
          ]
        },
        "coordinate": {
          "type": "object",
          "required": ["latitude", "longitude", "precision_class", "publication_policy"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90, "multipleOf": 0.01 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180, "multipleOf": 0.01 },
            "precision_class": { "const": "coarsened_2dp" },
            "publication_policy": { "const": "fixed_public_reference_only" }
          },
          "additionalProperties": false
        },
        "coordinate_claim_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "associated_organization_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
