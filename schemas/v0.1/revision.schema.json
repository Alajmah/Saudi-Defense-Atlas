{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/revision.schema.json",
  "title": "Saudi Defense Atlas Canonical Revision",
  "type": "object",
  "required": ["id", "proposal_id", "decision_id", "applied_at", "applied_by", "affected_records"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "proposal_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "decision_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "parent_revision_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "uniqueItems": true,
      "default": []
    },
    "applied_at": { "type": "string", "format": "date-time" },
    "applied_by": { "$ref": "common.schema.json#/$defs/actor" },
    "affected_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["resource_type", "record_id", "action"],
        "properties": {
          "resource_type": {
            "type": "string",
            "enum": ["entity", "claim", "event", "source", "document", "evidence"]
          },
          "record_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "action": {
            "type": "string",
            "enum": ["created", "superseded", "merged", "metadata_updated"]
          },
          "payload_sha256": {
            "type": ["string", "null"],
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "backend_receipts": {
      "type": "array",
      "description": "Adapter-specific write receipts. They are audit metadata and do not define domain authority.",
      "items": {
        "type": "object",
        "required": ["backend", "receipt"],
        "properties": {
          "backend": { "type": "string", "minLength": 1 },
          "receipt": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "rationale": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}