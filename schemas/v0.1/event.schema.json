{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sda:schema:v0.1:event",
  "title": "Saudi Defense Atlas Event",
  "type": "object",
  "required": ["id", "event_type", "occurred_at", "confidence", "evidence_links"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "event_type": {
      "type": "string",
      "enum": [
        "procurement_request",
        "procurement_approval_or_notification",
        "contract_award",
        "contract_signature",
        "order",
        "delivery_start",
        "delivery",
        "entry_into_service",
        "upgrade",
        "retirement",
        "cancellation",
        "suspension",
        "exercise",
        "training",
        "localization_agreement",
        "facility_opening",
        "other"
      ]
    },
    "names": { "$ref": "common.schema.json#/$defs/localized_text" },
    "occurred_at": { "$ref": "common.schema.json#/$defs/temporal_value" },
    "ended_at": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/temporal_value" },
        { "type": "null" }
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "role"],
        "properties": {
          "entity_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "role": {
            "type": "string",
            "enum": ["buyer", "seller", "contractor", "operator", "host", "participant", "observer", "supplier", "other"]
          }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "related_entity_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "uniqueItems": true,
      "default": []
    },
    "related_claim_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "uniqueItems": true,
      "default": []
    },
    "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
    "evidence_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "role"],
        "properties": {
          "evidence_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "role": {
            "type": "string",
            "enum": ["supports", "contradicts", "contextualizes"]
          }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}