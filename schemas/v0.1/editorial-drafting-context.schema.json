{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/editorial-drafting-context.schema.json",
  "title": "SDA Approved Drafting Context",
  "description": "Deterministic, provider-independent selection of already-approved canonical records that constitutes the ONLY input a bilingual drafting adapter may receive. The model drafts language; it does not choose facts.",
  "type": "object",
  "required": [
    "id",
    "created_at",
    "terminology_version",
    "entities",
    "claims",
    "evidence",
    "unknowns",
    "conflicts",
    "authority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SDA-DRAFTCTX-[A-Z0-9]{8,32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "terminology_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "entity_type", "names"],
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^SDA-[A-Z0-9-]+$"
          },
          "entity_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "names": {
            "type": "object",
            "required": ["en", "ar"],
            "additionalProperties": false,
            "properties": {
              "en": { "type": "string", "minLength": 1, "maxLength": 256 },
              "ar": { "type": "string", "minLength": 1, "maxLength": 256 }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "subject_entity_id",
          "predicate_id",
          "value",
          "claim_state",
          "evidence_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^SDA-CLAIM-[A-Z0-9-]+$"
          },
          "subject_entity_id": {
            "type": "string",
            "pattern": "^SDA-[A-Z0-9-]+$"
          },
          "predicate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": { "type": "object" },
          "validity": { "type": ["object", "null"] },
          "claim_state": { "const": "active" },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SDA-EVID-[A-Z0-9-]+$"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "document_id", "locator", "role"],
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^SDA-EVID-[A-Z0-9-]+$"
          },
          "document_id": {
            "type": "string",
            "pattern": "^SDA-DOC-[A-Z0-9-]+$"
          },
          "locator": { "type": "object" },
          "role": {
            "type": "string",
            "enum": ["supports", "contradicts", "contextualizes"]
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unknown_id", "aspect", "statement_en", "statement_ar"],
        "additionalProperties": false,
        "properties": {
          "unknown_id": {
            "type": "string",
            "pattern": "^UNK-[A-Z0-9-]+$"
          },
          "aspect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "entity_id": {
            "type": ["string", "null"],
            "pattern": "^SDA-[A-Z0-9-]+$"
          },
          "statement_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "statement_ar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 0,
      "description": "Drafting fails closed on unresolved factual conflict; an accepted context carries no conflicts."
    },
    "authority": {
      "type": "object",
      "required": [
        "mode",
        "canonical_mutation_authority",
        "publication_authority"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "approved_canonical_read_only" },
        "canonical_mutation_authority": { "const": false },
        "publication_authority": { "const": false }
      }
    }
  },
  "additionalProperties": false
}
