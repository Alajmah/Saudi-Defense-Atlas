{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/editorial-review-packet.schema.json",
  "title": "Saudi Defense Atlas Editorial Review Packet",
  "description": "Deterministic human-review handoff joining one editorial queue item, accepted AI extraction, resolver/verifier run, and the exact AMBER ChangeProposal payload. It carries no approval, mutation, or publication authority.",
  "type": "object",
  "required": [
    "id",
    "queue_item_id",
    "extraction_run_id",
    "resolution_run_id",
    "proposal_id",
    "proposal_sha256",
    "created_at",
    "review_state",
    "risk_class",
    "source_ids",
    "source_document_ids",
    "evidence_document_ids",
    "mutation_inventory",
    "assessment_summary",
    "review_flags",
    "authority"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "queue_item_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "extraction_run_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "resolution_run_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "proposal_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "proposal_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "review_state": { "const": "awaiting_human" },
    "risk_class": { "const": "AMBER" },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "uniqueItems": true
    },
    "source_document_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "uniqueItems": true
    },
    "evidence_document_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "uniqueItems": true
    },
    "mutation_inventory": {
      "type": "object",
      "required": ["total", "evidence", "claims", "events"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "evidence": { "type": "integer", "minimum": 1 },
        "claims": { "type": "integer", "minimum": 0 },
        "events": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "assessment_summary": {
      "type": "object",
      "required": [
        "new_claim_candidate_ids",
        "conflict_claim_candidate_ids",
        "duplicate_claim_candidate_ids",
        "new_event_candidate_ids",
        "possible_duplicate_event_candidate_ids",
        "blocked_ambiguous_candidate_ids",
        "blocked_unresolved_candidate_ids",
        "blocked_policy_candidate_ids"
      ],
      "properties": {
        "new_claim_candidate_ids": { "$ref": "#/$defs/candidate_ids" },
        "conflict_claim_candidate_ids": { "$ref": "#/$defs/candidate_ids" },
        "duplicate_claim_candidate_ids": { "$ref": "#/$defs/candidate_ids" },
        "new_event_candidate_ids": { "$ref": "#/$defs/candidate_ids" },
        "possible_duplicate_event_candidate_ids": { "$ref": "#/$defs/candidate_ids" },
        "blocked_ambiguous_candidate_ids": { "$ref": "#/$defs/candidate_ids" },
        "blocked_unresolved_candidate_ids": { "$ref": "#/$defs/candidate_ids" },
        "blocked_policy_candidate_ids": { "$ref": "#/$defs/candidate_ids" }
      },
      "additionalProperties": false
    },
    "review_flags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "ai_generated_proposal",
          "multi_source_context",
          "conflict_present",
          "ambiguity_blocked",
          "unresolved_entity_blocked",
          "policy_blocked",
          "duplicates_suppressed"
        ]
      },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "required": ["mode", "approval_authority", "canonical_mutation_authority", "publication_authority"],
      "properties": {
        "mode": { "const": "review_handoff_only" },
        "approval_authority": { "const": false },
        "canonical_mutation_authority": { "const": false },
        "publication_authority": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "candidate_ids": {
      "type": "array",
      "items": { "$ref": "ai-extraction-run.schema.json#/$defs/candidate_id" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
