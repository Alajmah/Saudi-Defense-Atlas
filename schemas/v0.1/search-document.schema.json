{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/search-document.schema.json",
  "title": "Saudi Defense Atlas Public Search Document",
  "description": "Backend-neutral public search projection. It contains canonical SDA identity, approved public naming text, deterministic normalized terms, and explicit facets only.",
  "type": "object",
  "required": [
    "id",
    "entity_type",
    "names",
    "aliases",
    "normalized_terms",
    "facets",
    "projected_at",
    "revision_ids"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "entity_type": {
      "type": "string",
      "enum": [
        "organization",
        "military_unit",
        "equipment",
        "equipment_variant",
        "facility",
        "exercise",
        "procurement_program",
        "contract",
        "localization_program",
        "country"
      ]
    },
    "subtype": { "type": ["string", "null"] },
    "names": { "$ref": "common.schema.json#/$defs/localized_text" },
    "aliases": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/alias" }
    },
    "descriptions": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/localized_text" },
        { "type": "null" }
      ]
    },
    "normalized_terms": {
      "type": "object",
      "required": ["ar", "en", "neutral"],
      "properties": {
        "ar": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "en": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "neutral": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "facets": {
      "type": "object",
      "required": [
        "service_ids",
        "manufacturer_ids",
        "country_ids",
        "equipment_classes",
        "status_values"
      ],
      "properties": {
        "service_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "manufacturer_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "country_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "equipment_classes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "status_values": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "projected_at": { "type": "string", "format": "date-time" },
    "revision_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
