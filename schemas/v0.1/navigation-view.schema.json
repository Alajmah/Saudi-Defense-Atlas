{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/navigation-view.schema.json",
  "title": "Saudi Defense Atlas Public Navigation View",
  "description": "Backend-neutral public filter catalog and timeline navigation derived from SearchDocument and RelationshipGraphView projections only.",
  "type": "object",
  "required": ["projected_at", "filters", "timeline", "provenance"],
  "properties": {
    "projected_at": { "type": "string", "format": "date-time" },
    "filters": {
      "type": "object",
      "required": ["entity_types", "service_ids", "manufacturer_ids", "country_ids", "equipment_classes", "status_values"],
      "properties": {
        "entity_types": { "$ref": "#/$defs/string_filter_options" },
        "service_ids": { "$ref": "#/$defs/entity_filter_options" },
        "manufacturer_ids": { "$ref": "#/$defs/entity_filter_options" },
        "country_ids": { "$ref": "#/$defs/entity_filter_options" },
        "equipment_classes": { "$ref": "#/$defs/string_filter_options" },
        "status_values": { "$ref": "#/$defs/string_filter_options" }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "array",
      "items": { "$ref": "#/$defs/timeline_item" }
    },
    "provenance": {
      "type": "object",
      "required": ["search_document_ids", "graph_record_ids", "revision_ids"],
      "properties": {
        "search_document_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "graph_record_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "revision_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "string_filter_option": {
      "type": "object",
      "required": ["value", "count"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "string_filter_options": {
      "type": "array",
      "items": { "$ref": "#/$defs/string_filter_option" }
    },
    "entity_filter_option": {
      "type": "object",
      "required": ["id", "names", "count"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
        "names": { "$ref": "common.schema.json#/$defs/localized_text" },
        "count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "entity_filter_options": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity_filter_option" }
    },
    "citation": {
      "type": "object",
      "required": ["evidence_id", "evidence_role", "document_id", "source_id"],
      "properties": {
        "evidence_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
        "evidence_role": { "type": "string", "enum": ["supports", "contradicts", "contextualizes"] },
        "document_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
        "source_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
        "url": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": false
    },
    "timeline_item": {
      "type": "object",
      "required": ["event_id", "event_type", "names", "occurred_at", "ended_at", "confidence", "domains", "root_entity_ids", "citations"],
      "properties": {
        "event_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
        "event_type": { "type": "string", "minLength": 1 },
        "names": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/localized_text" },
            { "type": "null" }
          ]
        },
        "occurred_at": { "$ref": "common.schema.json#/$defs/temporal_value" },
        "ended_at": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/temporal_value" },
            { "type": "null" }
          ]
        },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["procurement", "exercise"] },
          "uniqueItems": true
        },
        "root_entity_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
