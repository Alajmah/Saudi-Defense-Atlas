{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/procurement-program-view.schema.json",
  "title": "Saudi Defense Atlas Public Procurement Program View",
  "type": "object",
  "required": ["id", "entity_type", "names", "descriptions", "lifecycle_state", "facts", "graph", "staleness", "provenance"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "entity_type": { "const": "procurement_program" },
    "names": { "$ref": "common.schema.json#/$defs/localized_text" },
    "descriptions": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/localized_text" },
        { "type": "null" }
      ]
    },
    "lifecycle_state": {
      "type": "object",
      "required": ["state", "claim_ids", "values", "reason"],
      "properties": {
        "state": { "type": "string", "enum": ["known", "disputed", "unknown"] },
        "claim_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "values": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "predicate_id", "value", "confidence", "claim_state", "citations"],
        "properties": {
          "claim_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "predicate_id": { "type": "string", "enum": ["procurement_program.lifecycle_state", "procurement.quantity"] },
          "value": { "$ref": "common.schema.json#/$defs/claim_value" },
          "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
          "claim_state": { "type": "string", "enum": ["active", "disputed"] },
          "validity": { "$ref": "common.schema.json#/$defs/validity_interval" },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "relationship-graph-view.schema.json#/$defs/citation" }
          }
        },
        "additionalProperties": false
      }
    },
    "graph": { "$ref": "relationship-graph-view.schema.json" },
    "staleness": {
      "type": "array",
      "items": { "$ref": "staleness-report.schema.json#/properties/items/items" }
    },
    "provenance": {
      "type": "object",
      "required": ["projected_at", "record_ids", "revision_ids"],
      "properties": {
        "projected_at": { "type": "string", "format": "date-time" },
        "record_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "revision_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
