{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/claim.schema.json",
  "title": "Saudi Defense Atlas Claim",
  "type": "object",
  "required": ["id", "subject_id", "predicate_id", "value", "confidence", "evidence_links", "claim_state", "created_at"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "subject_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "predicate_id": {
      "type": "string",
      "enum": [
        "organization.parent_of.organization",
        "organization.operates.equipment_variant",
        "military_unit.part_of.organization",
        "military_unit.operates.equipment_variant",
        "manufacturer.manufactures.equipment",
        "company.participates_in.procurement_program",
        "equipment_variant.variant_of.equipment",
        "procurement_program.acquires.equipment_variant",
        "contract.part_of.procurement_program",
        "contract.awarded_to.company",
        "exercise.participant.organization",
        "exercise.uses.equipment_variant",
        "localization_program.related_to.equipment",
        "facility.associated_with.organization",
        "equipment.service_state",
        "procurement_program.lifecycle_state",
        "inventory.quantity",
        "procurement.quantity"
      ]
    },
    "value": { "$ref": "common.schema.json#/$defs/claim_value" },
    "scope": {
      "type": "object",
      "properties": {
        "entity_ids": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "uniqueItems": true
        },
        "quantity_type": {
          "type": ["string", "null"],
          "enum": [
            "ordered",
            "approved",
            "contracted",
            "delivered",
            "operational_estimate",
            "original_fleet",
            "upgraded",
            "retired_or_lost",
            null
          ]
        },
        "note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "validity": { "$ref": "common.schema.json#/$defs/validity_interval" },
    "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
    "evidence_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "role"],
        "properties": {
          "evidence_id": { "$ref": "common.schema.json#/$defs/canonical_id" },
          "role": {
            "type": "string",
            "enum": ["supports", "contradicts", "contextualizes"]
          }
        },
        "additionalProperties": false
      }
    },
    "claim_state": {
      "type": "string",
      "enum": ["active", "disputed", "superseded", "withdrawn"]
    },
    "supersedes_claim_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "uniqueItems": true,
      "default": []
    },
    "verified_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}