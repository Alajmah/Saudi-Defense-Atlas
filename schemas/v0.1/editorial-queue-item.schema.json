{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.saudi-defense-atlas.org/v0.1/editorial-queue-item.schema.json",
  "title": "Saudi Defense Atlas Editorial Queue Item",
  "description": "Operational routing record for source material awaiting discovery review, candidate extraction, or restricted human handling. It has no canonical mutation authority.",
  "type": "object",
  "required": [
    "id",
    "observation_ids",
    "source_ids",
    "document_ids",
    "dedupe_key",
    "lane",
    "state",
    "priority",
    "reason_codes",
    "ai_extraction_allowed",
    "canonical_mutation_authority",
    "created_at"
  ],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/canonical_id" },
    "observation_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "uniqueItems": true
    },
    "document_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/canonical_id" },
      "uniqueItems": true
    },
    "dedupe_key": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" },
    "lane": {
      "type": "string",
      "enum": ["candidate_extraction", "discovery_review", "restricted_human"]
    },
    "state": { "type": "string", "enum": ["queued", "claimed", "completed", "dismissed"] },
    "priority": { "type": "string", "enum": ["normal", "high"] },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 },
      "uniqueItems": true
    },
    "ai_extraction_allowed": { "type": "boolean" },
    "canonical_mutation_authority": { "const": false },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "lane": { "const": "candidate_extraction" } }, "required": ["lane"] },
      "then": { "properties": { "ai_extraction_allowed": { "const": true } } }
    },
    {
      "if": { "properties": { "lane": { "enum": ["discovery_review", "restricted_human"] } }, "required": ["lane"] },
      "then": { "properties": { "ai_extraction_allowed": { "const": false } } }
    }
  ],
  "additionalProperties": false
}